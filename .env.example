# ─── Server ────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001
WEB_URL=http://localhost:3000

# ─── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://jobpilot:jobpilot_dev@localhost:5432/jobpilot

# ─── Redis (optional; not currently required) ──────────────
# REDIS_URL=redis://localhost:6379

# ─── Auth ──────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change_me_to_64_hex_chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ─── Encryption for stored user API keys ──────────────────
# REQUIRED if any user saves an AI API key via Settings.
# Generate with: openssl rand -hex 32  (must be at least 16 chars)
AI_KEY_ENCRYPTION_SECRET=change_me_to_a_long_random_string_at_least_32_chars

# ─── AI provider (server-side fallback) ────────────────────
# Per-user keys stored via Settings → AI Provider take precedence over these.
# Set AI_PROVIDER + the matching *_API_KEY for a server-wide default.
# Valid AI_PROVIDER values: GROQ | ANTHROPIC | GEMINI | OPENAI
AI_PROVIDER=GROQ

# Groq (free tier; OpenAI-compatible)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro-latest
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# OpenAI / Codex / any OpenAI-compatible endpoint (OpenRouter, Together, vLLM, ...)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# ─── Batch scoring ─────────────────────────────────────────
# Concurrent batches against the AI provider.
# Default is conservative for Groq's free RPM tier.
SCORE_CONCURRENCY=3

# ─── Portal scanner (Playwright-based) ─────────────────────
PORTAL_SCAN_CONCURRENCY=3
PORTAL_NAV_TIMEOUT_MS=30000
PORTAL_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Safari/537.36
# PLAYWRIGHT_BROWSERS_PATH=

# ─── Resume PDF storage (served via auth-gated endpoint) ───
# These files are user-private and must NOT live under public/.
# Served by GET /resumes/:applicationId/ats-pdf with JWT auth.
RESUME_PDF_DIR=storage/resumes
RESUME_PDF_BASE_URL=/resumes

# ─── Auto-apply (fill-and-pause) ───────────────────────────
AUTOAPPLY_DAILY_CAP=20
AUTOAPPLY_SCREENSHOT_DIR=storage/autoapply
AUTOAPPLY_SCREENSHOT_BASE_URL=/autoapply

# ─── Job providers ─────────────────────────────────────────
# Free, no-key providers (Remotive, Arbeitnow, Jobicy, TheMuse, RemoteOK) run
# automatically. The two below are key-gated — leave blank to skip them.

# Adzuna — 20+ countries. Sign up: https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRIES=us,gb,de,in,au,ca
ADZUNA_QUERY=
ADZUNA_RESULTS_PER_PAGE=50
ADZUNA_MAX_PAGES=2

# JSearch (RapidAPI) — covers LinkedIn / Indeed / Glassdoor / ZipRecruiter.
# Subscribe (free BASIC tier ~200 req/month): https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_RAPIDAPI_KEY=
JSEARCH_QUERY=Software Engineer
JSEARCH_COUNTRY=us
JSEARCH_PAGES=2
JSEARCH_REMOTE_ONLY=false
