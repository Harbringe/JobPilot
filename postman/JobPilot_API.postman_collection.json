{
    "info": {
        "name": "JobPilot API",
        "description": "Complete API collection for JobPilot backend. Import the environment file first, then run requests in order.\n\n**Auto-magic:** Login/Register/Refresh automatically save tokens to environment variables. All protected requests use {{accessToken}} from the environment.\n\n**Quick Start:**\n1. Import this collection + environment\n2. Run \"Login (Demo)\" to auto-populate tokens\n3. Test any endpoint",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [],
    "item": [
        {
            "name": "🏥 Health",
            "item": [
                {
                    "name": "Health Check",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/health",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "health"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "🔐 Auth",
            "item": [
                {
                    "name": "Register",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "if (pm.response.code === 201) {",
                                    "    const data = pm.response.json().data;",
                                    "    pm.environment.set('accessToken', data.accessToken);",
                                    "    pm.environment.set('refreshToken', data.refreshToken);",
                                    "    pm.environment.set('userId', data.user.id);",
                                    "    pm.test('Registration successful', () => pm.expect(data.user.email).to.exist);",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "url": {
                            "raw": "{{baseUrl}}/auth/register",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "register"
                            ]
                        },
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"newuser@example.com\",\n    \"password\": \"TestPass123\",\n    \"name\": \"New User\"\n}"
                        }
                    }
                },
                {
                    "name": "Login (Demo)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "if (pm.response.code === 200) {",
                                    "    const data = pm.response.json().data;",
                                    "    pm.environment.set('accessToken', data.accessToken);",
                                    "    pm.environment.set('refreshToken', data.refreshToken);",
                                    "    pm.environment.set('userId', data.user.id);",
                                    "    pm.test('Login successful', () => pm.expect(data.accessToken).to.be.a('string'));",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "url": {
                            "raw": "{{baseUrl}}/auth/login",
                            "host": [
