        "jsonwebtoken": "^9.0.0",
        "morgan": "^1.10.0",
        "zod": "^3.24.0"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.0",
        "@types/cors": "^2.8.0",
        "@types/express": "^5.0.0",
        "@types/jsonwebtoken": "^9.0.0",
        "@types/morgan": "^1.9.0",
        "@types/node": "^22.0.0",
